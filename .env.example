POSTGRES_HOST=localhost
POSTGRES_DB=nexusagent
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus-local-password
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
NEXUS_REDIS_ENABLED=true
NEXUS_REDIS_RECENT_SESSION_TTL=24h
NEXUS_REDIS_SESSION_SUMMARY_TTL=7d
NEXUS_REDIS_RETRIEVAL_CACHE_TTL=30m
NEXUS_REDIS_TOOL_OUTPUT_TTL=2h
NEXUS_REDIS_QUERY_STATUS_TTL=30m
NEXUS_REDIS_MAX_RECENT_SESSION_EVENTS=25
NEXUS_REDIS_MAX_CACHE_ENTRY_BYTES=131072
NEXUS_REDIS_MAX_TOOL_OUTPUT_BYTES=65536

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=nexus-documents

NEXUS_UPLOAD_MAX_FILE_SIZE_BYTES=26214400
NEXUS_MULTIPART_MAX_IN_MEMORY_SIZE=1MB
NEXUS_MULTIPART_MAX_DISK_USAGE_PER_PART=30MB
NEXUS_MULTIPART_MAX_PARTS=4

NEXUS_CHUNKING_PARENT_MAX_CHARS=1200
NEXUS_CHUNKING_CHILD_MAX_CHARS=400
NEXUS_CHUNKING_CHILD_OVERLAP_CHARS=80

NEXUS_EMBEDDINGS_PROVIDER=local
NEXUS_EMBEDDINGS_DIMENSION=384
# Set provider=openai only after reviewing external text transfer and vector migration.
NEXUS_EMBEDDINGS_MODEL=text-embedding-3-small
NEXUS_OPENAI_EMBEDDING_TIMEOUT=20s
NEXUS_OPENAI_ANSWER_TIMEOUT=90s
# Real answers require both answer and embedding providers=openai; sends selected evidence externally.
NEXUS_ANSWER_PROVIDER=local
NEXUS_LIVE_CONTEXT_TIMEOUT=45s
NEXUS_QUERY_STATE_TIMEOUT=2s
# Versioned live context cache; never caches final model answers. Requires Redis enabled.
NEXUS_LIVE_CACHE_ENABLED=true
NEXUS_LIVE_CACHE_TTL=15m
NEXUS_LIVE_CACHE_TIMEOUT=500ms
NEXUS_LIVE_CACHE_MAX_BYTES=131072

NEXUS_RETRIEVAL_DEFAULT_TOP_K=10
NEXUS_RETRIEVAL_MAX_TOP_K=50
NEXUS_RETRIEVAL_RRF_K=60

NEXUS_CONTEXT_DEFAULT_BUDGET_CHARS=4000
NEXUS_CONTEXT_MAX_BUDGET_CHARS=12000

NEXUS_QUERY_CONTEXT_TIMEOUT=20s
NEXUS_QUERY_ANSWER_TIMEOUT=5s

# Optional read-only Agent Harness. Disabled by default; scripted uses no LLM.
# Generate a private worker token with: openssl rand -hex 32
NEXUS_AGENT_ENABLED=false
NEXUS_AGENT_WORKER_MODE=scripted
NEXUS_AGENT_API_URL=http://localhost:8080
NEXUS_AGENT_WORKER_TOKEN=
NEXUS_AGENT_LEASE=45s
NEXUS_AGENT_ACTIVE_TIMEOUT=180s
NEXUS_AGENT_TOOL_TIMEOUT=10s
NEXUS_AGENT_MAX_TOOLS=30
NEXUS_AGENT_MAX_ROUNDS=12
NEXUS_AGENT_APPROVAL_TTL=30m
NEXUS_AGENT_MAX_RECOVERIES=3
NEXUS_AGENT_EVENT_POLL_INTERVAL=1s
NEXUS_AGENT_MAX_EVENTS=500

# Shared credentials/model for optional Pi and the Java live answer adapter.
# Java live answers currently call OpenAI directly; NEXUS_LLM_PROVIDER selects the Pi provider only.
# Real credentials belong only in ignored .env or runtime environment variables.
NEXUS_LLM_PROVIDER=
NEXUS_LLM_MODEL=gpt-5.6-luna
NEXUS_LLM_API_KEY=
